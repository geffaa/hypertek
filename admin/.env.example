# ============================================================
# HYPER TEK — Admin Panel Environment Variables Reference
# ============================================================
# Copy this file to .env.local (development) or .env.production
# NEVER commit actual values to Git!

# Backend API URL  
VITE_BACKEND_URL=http://localhost:4700
# VITE_BACKEND_URL=https://api.hypertek100.com

# Frontend URL (for redirect on logout/auth failure)
VITE_FRONTEND_URL=http://localhost:5173
# VITE_FRONTEND_URL=https://hyper-tek-games.deventiatech.com

# Platform wallet — initial owner of all admin-created items (matches backend PLATFORM_WALLET_ADDRESS)
VITE_PLATFORM_WALLET_ADDRESS=0x...
